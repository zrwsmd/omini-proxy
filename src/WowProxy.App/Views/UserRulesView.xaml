<UserControl x:Class="WowProxy.App.Views.UserRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WowProxy.App.Views"
             xmlns:domain="clr-namespace:WowProxy.Domain;assembly=WowProxy.Domain"
             xmlns:converters="clr-namespace:WowProxy.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:RuleTypeDisplayConverter x:Key="RuleTypeDisplayConverter" />
        <converters:RuleActionDisplayConverter x:Key="RuleActionDisplayConverter" />
        <ObjectDataProvider x:Key="RuleTypeEnum" MethodName="GetValues" ObjectType="{x:Type domain:RuleType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domain:RuleType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="RuleActionEnum" MethodName="GetValues" ObjectType="{x:Type domain:RuleAction}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domain:RuleAction" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题和说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="自定义路由规则" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12">
                <Run Text="规则优先级：列表中排在上面的规则优先级更高，遇到第一条匹配的规则就停止，不再往下走。" />
                <LineBreak />
                <Run Text="修改规则后需要重启连接才能生效。" FontWeight="Bold" />
            </TextBlock>
        </StackPanel>

        <!-- 添加规则表单 -->
        <Border Grid.Row="1" Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 标签行 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="规则类型" FontSize="11" Foreground="#666" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="规则值" FontSize="11" Foreground="#666" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="出站动作" FontSize="11" Foreground="#666" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="备注（可选）" FontSize="11" Foreground="#666" Margin="0,0,0,4" />

                    <!-- 输入行 -->
                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Source={StaticResource RuleTypeEnum}}" 
                              SelectedItem="{Binding NewType}" Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RuleTypeDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,8,0" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewValue}" Value="">
                                        <Setter Property="Background" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.ToolTip>
                            <ToolTip Content="{Binding NewValueHint}" />
                        </TextBox.ToolTip>
                    </TextBox>

                    <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Source={StaticResource RuleActionEnum}}" 
                              SelectedItem="{Binding NewAction}" Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RuleActionDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NewRemark, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,8,0" VerticalContentAlignment="Center" />

                    <Button Grid.Row="1" Grid.Column="4" Content="添加规则" Padding="16,4" Command="{Binding AddRuleCommand}" />
                </Grid>

                <!-- 验证错误提示 -->
                <TextBlock Grid.Row="1" Text="{Binding ValidationError}" Foreground="Red" FontSize="11" 
                           Margin="0,4,0,0" Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- 规则列表 -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#CCC">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="规则类型" Binding="{Binding TypeDisplay}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="出站动作" Binding="{Binding ActionDisplay}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Action}" Value="Block">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Action}" Value="Proxy">
                                    <Setter Property="Foreground" Value="Green" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Action}" Value="Direct">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="150" IsReadOnly="True" />
                <DataGridTemplateColumn Header="操作" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="↑" Width="24" Height="24" Margin="2" 
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="上移" FontSize="10" />
                                <Button Content="↓" Width="24" Height="24" Margin="2" 
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="下移" FontSize="10" />
                                <Button Content="✕" Width="24" Height="24" Margin="2" 
                                        Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="删除" Foreground="Red" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
