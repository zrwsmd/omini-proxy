<Window x:Class="WowProxy.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 (可拖动) -->
            <Grid Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="⚠️ 确认操作" FontWeight="Bold" FontSize="16" Foreground="#1F2937" Margin="20,16,20,12"/>
            </Grid>

            <!-- 分割线 -->
            <Border Grid.Row="1" Height="1" Background="#F3F4F6" Margin="0,0,0,16"/>

            <!-- 内容区 -->
            <StackPanel Grid.Row="2" Margin="20,0,20,24">
                <TextBlock x:Name="MessageText" Text="确定要执行此操作吗？" TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" LineHeight="22" />
            </StackPanel>

            <!-- 底部按钮区 -->
            <Border Grid.Row="3" Background="#F9FAFB" CornerRadius="0,0,8,8" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="80" Height="36" Click="CancelButton_Click" IsCancel="True" 
                            Style="{StaticResource ModernBtn}" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" 
                            Foreground="#4B5563" Cursor="Hand" Margin="0,0,12,0" FontSize="14" />
                    <Button x:Name="ConfirmButton" Content="确定" Width="80" Height="36" Click="ConfirmButton_Click" IsDefault="True" 
                            Style="{StaticResource ModernBtn}" Background="#EF4444" BorderThickness="0" 
                            Foreground="White" FontWeight="Bold" Cursor="Hand" FontSize="14" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
